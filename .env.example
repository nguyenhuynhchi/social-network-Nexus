# Docker host ports
API_GATEWAY_PORT=8888
AUTHENTICATION_SERVICE_PORT=8080
PROFILE_SERVICE_PORT=8081
NOTIFICATION_SERVICE_PORT=8082
POST_SERVICE_PORT=8083
CLOUDINARY_UPLOAD_PORT=8084
CHAT_SERVICE_PORT=8085
CHAT_WEBSOCKET_PORT=8099
FRONTEND_PORT=5173

# Application paths
API_PREFIX=/nexus/v1
API_GATEWAY_STRIP_PREFIX=2

# Frontend build-time config
VITE_API_GATEWAY_URL=http://localhost:8888/nexus/v1
VITE_CHAT_SOCKET_URL=http://localhost:8099

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo-password
POST_MONGODB_URI=mongodb://root:change-me-mongo-password@mongodb:27017/post-service?authSource=admin
CHAT_MONGODB_URI=mongodb://root:change-me-mongo-password@mongodb:27017/chat-service?authSource=admin

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
MYSQL_DATABASE=authentication_service
AUTH_DB_URL=jdbc:mysql://mysql:3306/authentication_service
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=change-me-mysql-root-password

# Neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
NEO4J_AUTH=neo4j/change-me-neo4j-password
NEO4J_URI=bolt://neo4j:7687

# Kafka
KAFKA_EXTERNAL_PORT=9094
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ADVERTISED_EXTERNAL_HOST=localhost
NOTIFICATION_KAFKA_GROUP_ID=notification-group

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
GATEWAY_INTROSPECTION_CACHE_TTL_SECONDS=30

# JWT
JWT_SIGNER_KEY=change-me-to-a-long-random-base64-secret
JWT_VALID_DURATION=36000
JWT_REFRESHABLE_DURATION=36000

# Internal service URLs
AUTHENTICATION_SERVICE_BASE_URL=http://authentication-service:8080
PROFILE_SERVICE_BASE_URL=http://profile-service:8081
POST_SERVICE_BASE_URL=http://post-service:8083
CHAT_SERVICE_BASE_URL=http://chat-service:8085
AUTHENTICATION_SERVICE_URL=http://authentication-service:8080/authentication
PROFILE_SERVICE_URL=http://profile-service:8081/profile
POST_SERVICE_URL=http://post-service:8083/post
CHAT_SERVICE_URL=http://chat-service:8085/chat
CLOUDINARY_UPLOAD_URL=http://cloudinary-upload:8084/cloudinary

# Upload limits
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=20MB
FILE_MAX_SIZE_MB=10
FILE_MAX_REQUEST_SIZE=20
CLOUDINARY_MAX_REQUEST_SIZE=10MB

# Brevo / Sendinblue
BREVO_URL=https://api.brevo.com
BREVO_API_KEY=replace-with-new-brevo-api-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
